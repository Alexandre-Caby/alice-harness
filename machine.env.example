# Settings of this installation: changed by sudo ./install.sh, or by hand followed by sudo ./install.sh update.

# Installation
ALICE_PREFIX=alice
ALICE_DATA_DIR=/srv/alice-harness
ALICE_TIMEZONE=UTC
ALICE_WEBUI_NAME=A.L.I.C.E.
# Public address of Open WebUI, through your tunnel or reverse proxy
ALICE_WEBUI_URL=
# Sign-in through an OpenID Connect provider: its discovery URL (…/.well-known/openid-configuration) and the label of its
# button; empty = passwords only. Needs ALICE_WEBUI_URL and the secrets OAUTH_CLIENT_ID and OAUTH_CLIENT_SECRET. Accounts
# are found by e-mail, so the provider must verify e-mail addresses; it never creates an account.
ALICE_OIDC_PROVIDER_URL=
ALICE_OIDC_NAME=SSO
# vulkan | rocm | cuda | cpu
ALICE_BACKEND=vulkan

# Secrets: file | openbao | command (security/SECRETS.md)
ALICE_SECRET_STORE=file
ALICE_SECRETS_FILE=/etc/alice-harness/secrets.env
# openbao only
ALICE_OPENBAO_ADDR=http://127.0.0.1:8200
ALICE_OPENBAO_PATH=secret/alice-harness
# command only; {name} is replaced by the secret's name
ALICE_SECRET_COMMAND=

# Networks: only the services allowed out join the egress network
ALICE_NET_CORE=alice-core
ALICE_NET_CORE_SUBNET=10.50.0.0/24
ALICE_NET_EGRESS=alice-egress
ALICE_NET_EGRESS_SUBNET=10.51.0.0/24
ALICE_NET_WORKSPACE=alice-workspace
ALICE_NET_WORKSPACE_SUBNET=10.52.0.0/24

# Ollama: native (installed and set up by the harness) | external (an Ollama you already run)
ALICE_OLLAMA_MODE=native
ALICE_OLLAMA_URL=http://10.50.0.1:11434
ALICE_OLLAMA_MAX_LOADED_MODELS=2
ALICE_OLLAMA_NUM_PARALLEL=2
# Tokens one chat can hold (tool results included); memory grows with it, once per parallel chat
ALICE_OLLAMA_CONTEXT_LENGTH=65536

# Chat models: id=model|Name, separated by ";", the first being the default. Append |think=off to answer without
# thinking first (faster, measurably worse at using tools).
ALICE_PRESETS="alice=gemma4:26b|Alice;alice-fast=qwen3.6:35b-a3b|Alice fast;alice-heavy=hf.co/ornith-ai/Ornith-1.5-35B-A3B-GGUF:Q8_0|Alice heavy"
# Your own soul (system prompt); empty = core/soul/SOUL.md
ALICE_SOUL_FILE=

# Modules, chosen during the installation
ALICE_MODULES=

# ocr: languages joined with +, among eng fra deu ita spa jpn
ALICE_OCR_LANGUAGES=eng

# workspace: accounts (e-mails) that get one, space-separated; filled in when people are added
ALICE_WORKSPACE_USERS=
# workspace: its name in Open WebUI, {name} being the account's name; empty = Workspace of {name}
ALICE_WORKSPACE_LABEL=
# workspace: a folder mounted read-only on this machine (a network drive, for example), shown in every workspace as
# ~/<ALICE_SHARED_NAME> (see modules/workspace/ORIGIN.md)
ALICE_SHARED_PATH=
ALICE_SHARED_NAME=shared

# stt and tts: the language spoken (English, French, …)
ALICE_STT_LANGUAGE=English
ALICE_TTS_LANGUAGE=English
# tts: an optional cloned voice (.qvoice), kept outside the repository
ALICE_TTS_VOICE_FILE=

# n8n: sites it may reach through the egress proxy, space-separated; .example.com includes subdomains
ALICE_EGRESS_N8N=

# backup: repository folder (empty = /var/backups/<prefix>), and other paths to back up, space-separated
ALICE_BACKUP_DIR=
ALICE_BACKUP_EXTRA=

# ntfy: topic of the health alerts; empty = none
ALICE_ALERT_TOPIC=

# Public addresses through your reverse proxy or tunnel; empty when not exposed
ALICE_N8N_URL=
ALICE_NTFY_URL=
